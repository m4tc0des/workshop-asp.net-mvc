@model IEnumerable<SalesWebMvc.Models.Entities.SalesRecord>

@{
    ViewData["Title"] = "Simple Search";
}

<h2>@ViewData["Title"]</h2>

<nav class="navbar navbar-inverse">
    <div class="container-fluid">
        <form class="d-flex" role="search" method="get">
            <div class="form-group me-1">
                <label for="minDate">Min Date</label>
                <input type="date" class="form-control" name="minDate"
                       value="@ViewData["minDate"]" />
            </div>
            <div class="form-group me-1">
                <label for="maxDate">Max Date</label>
                <input type="date" class="form-control" name="maxDate"
                       value="@ViewData["maxDate"]" />
            </div>
            <button type="submit" class="btn btn-primary" data-bs-toggle="tooltip" data-bs-title="Filtrar">
                <i class="bi bi-filter"></i>
            </button>
        </form>
    </div>
</nav>

@if (Model != null && Model.Any())
{
    <div class="card card-primary mt-3">
        <div class="card-header">
            Resultados
        </div>
        <div class="card-body text-bg-primary">
            <h4 class="card-title">
                Total sales: $ @Model.Sum(s => s.Amount).ToString("N2")
            </h4>
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-primary">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.First().Date)</th>
                            <th>@Html.DisplayNameFor(model => model.First().Seller)</th>
                            <th>@Html.DisplayNameFor(model => model.First().Seller.Department)</th>
                            <th>@Html.DisplayNameFor(model => model.First().Amount)</th>
                            <th>@Html.DisplayNameFor(model => model.First().Status)</th>
                        </tr>
                    </thead>
                    <tbody class="table-group-divider">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Date.ToString("dd/MM/yyyy")</td>
                                <td>@item.Seller.Name</td>
                                <td>@item.Seller.Department?.Name</td>
                                <td>$ @item.Amount.ToString("N2")</td>
                                <td>@item.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning mt-3">
        Nenhum resultado encontrado para o período selecionado.
    </div>
}