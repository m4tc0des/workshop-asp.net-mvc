@model IEnumerable<IGrouping<Department, SalesRecord>>
@using SalesWebMvc.Models.Entities

@{
    ViewData["Title"] = "Grouping Search";
    DateTime.TryParse(ViewData["minDate"] as string, out DateTime minDate);
    DateTime.TryParse(ViewData["maxDate"] as string, out DateTime maxDate);
}

<h2>@ViewData["Title"]</h2>

<nav class="navbar navbar-inverse">
    <div class="container-fluid">
        <form class="d-flex" role="search" method="get">
            <div class="form-group me-1">
                <label for="minDate">Min Date</label>
                <input type="date" class="form-control" name="minDate" value="@ViewData["minDate"]" />
            </div>
            <div class="form-group me-1">
                <label for="maxDate">Max Date</label>
                <input type="date" class="form-control" name="maxDate" value="@ViewData["maxDate"]" />
            </div>
            <button type="submit" class="btn btn-primary" data-bs-toggle="tooltip" data-bs-title="Filter">
                <i class="bi bi-filter"></i>
            </button>
        </form>
    </div>
</nav>

<div class="card card-primary mt-3">
    <div class="card-header">
        Results
    </div>

    @foreach (var departmentGroup in Model.OrderBy(g => g.Key.Name))
    {
        <div class="card-body text-bg-primary mb-4">
            <h3 class="card-title">Department @departmentGroup.Key.Name</h3>
            <h4 class="card-subtitle mb-2">
                Total Sales: $ @departmentGroup.Key.TotalSales(minDate, maxDate).ToString("N2")
            </h4>
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-primary">
                        <tr>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Seller</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody class="table-group-divider">
                        @foreach (var salesRecord in departmentGroup.OrderByDescending(s => s.Date))
                        {
                            <tr>
                                <td>@salesRecord.Date.ToString("dd/MM/yyyy")</td>
                                <td>$ @salesRecord.Amount.ToString("N2")</td>
                                <td>@salesRecord.Seller.Name</td>
                                <td>@salesRecord.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>